{
  "$schema": "../schemas/quality-gates.schema.json",
  "policyVersion": "0.0.0-bootstrap",
  "stage": "bootstrap",
  "supportClaims": [],
  "cadences": [
    {
      "id": "fast",
      "scope": "local",
      "extends": []
    },
    {
      "id": "pull-request",
      "scope": "pull-request",
      "extends": [
        "fast"
      ]
    },
    {
      "id": "main-nightly",
      "scope": "main",
      "extends": [
        "pull-request"
      ]
    },
    {
      "id": "release-candidate",
      "scope": "release",
      "extends": [
        "main-nightly"
      ]
    }
  ],
  "profiles": [
    {
      "id": "modular-monolith-alpha",
      "maturity": "experimental",
      "preset": "modular-monolith",
      "providers": [
        "postgresql",
        "sqlserver"
      ],
      "cadences": [
        "release-candidate"
      ],
      "gates": [
        "modular-monolith.generated-solution",
        "modular-monolith.architecture",
        "modular-monolith.provider-integration",
        "modular-monolith.migration",
        "modular-monolith.reliability",
        "modular-monolith.release-evidence"
      ],
      "command": "npm run verify:modular-monolith-alpha"
    }
  ],
  "gates": [
    {
      "id": "bootstrap.manifest",
      "family": "repository-integrity",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "The repository manifest and versioned schema are present, coherent, and secret-free."
    },
    {
      "id": "bootstrap.governance",
      "family": "repository-integrity",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "Ownership, licensing, contribution, security, and provenance authorities are present."
    },
    {
      "id": "bootstrap.generated-solution",
      "family": "template-generation",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "The explicitly named temporary Generated Solution fixture has the minimum routed and manifest surfaces."
    },
    {
      "id": "bootstrap.modular-monolith",
      "family": "template-generation",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "The named Modular Monolith Generated Solution has explicit executable, module, Contracts, and consolidated test boundaries."
    },
    {
      "id": "bootstrap.host-baseline",
      "family": "security-observability",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "Generated API hosts explicitly compose fail-fast security, fail-closed authorization, redaction, telemetry, probes, overload, cancellation, and outbound safety."
    },
    {
      "id": "bootstrap.secret-free",
      "family": "security-supply-chain",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "Bootstrap metadata declares external-only secret delivery and contains no secret values."
    },
    {
      "id": "bootstrap.agent-readiness",
      "family": "agent-readiness",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "fast",
        "pull-request",
        "main-nightly",
        "release-candidate"
      ],
      "purpose": "Generated Solutions expose deterministic, secret-free, authority-routed context and safe maintenance, migration, and hostile-input evidence."
    },
    {
      "id": "modular-monolith.generated-solution",
      "family": "template-generation",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "release-candidate"
      ],
      "purpose": "Both named relational variants are generated deterministically from the exact alpha inputs."
    },
    {
      "id": "modular-monolith.architecture",
      "family": "architecture",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "release-candidate"
      ],
      "purpose": "Generated API, Migrator, Business Module, Contracts, persistence, and consolidated TUnit boundaries remain explicit."
    },
    {
      "id": "modular-monolith.provider-integration",
      "family": "provider-integration",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "release-candidate"
      ],
      "purpose": "PostgreSQL and SQL Server execute the selected provider APIs against real external databases without provider substitution."
    },
    {
      "id": "modular-monolith.migration",
      "family": "migration",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "release-candidate"
      ],
      "purpose": "Fresh, historical, idempotent, script, and migration-database separation evidence passes for each relational variant."
    },
    {
      "id": "modular-monolith.reliability",
      "family": "reliability-operations",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "release-candidate"
      ],
      "purpose": "Real-provider transaction rollback, optimistic concurrency, leased queue expiry, crash redelivery, and transactional Inbox deduplication prove one durable business effect."
    },
    {
      "id": "modular-monolith.release-evidence",
      "family": "release-evidence",
      "owner": "platform-maintainers",
      "required": true,
      "cadences": [
        "release-candidate"
      ],
      "purpose": "Immutable candidate evidence records exact artifacts, manifests, gates, compatibility coordinates, and Experimental maturity without Supported claims."
    }
  ]
}
