{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MartiXDev/Platform/schemas/quality-gates.schema.json",
  "title": "MartiX Platform quality-gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "policyVersion",
    "stage",
    "supportClaims",
    "cadences",
    "profiles",
    "gates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "bootstrap"
    },
    "supportClaims": {
      "type": "array",
      "maxItems": 0
    },
    "cadences": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cadence"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "extends"
      ],
      "properties": {
        "id": {
          "enum": [
            "fast",
            "pull-request",
            "main-nightly",
            "release-candidate"
          ]
        },
        "scope": {
          "enum": [
            "local",
            "pull-request",
            "main",
            "release"
          ]
        },
        "extends": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "fast",
              "pull-request",
              "main-nightly",
              "release-candidate"
            ]
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "owner",
        "required",
        "cadences",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:bootstrap|modular-monolith|beta|release-candidate|stable|canonical)\\.[a-z0-9-]+$"
        },
        "family": {
          "enum": [
            "repository-integrity",
            "security-supply-chain",
            "security-observability",
            "agent-readiness",
            "template-generation",
            "architecture",
            "provider-integration",
            "migration",
            "reliability-operations",
            "release-evidence"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        },
        "cadences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "fast",
              "pull-request",
              "main-nightly",
              "release-candidate"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/modularMonolithAlphaProfile"
        },
        {
          "$ref": "#/$defs/betaIntegrationProfile"
        },
        {
          "$ref": "#/$defs/releaseCandidateProfile"
        },
        {
          "$ref": "#/$defs/stablePromotionProfile"
        },
        {
          "$ref": "#/$defs/canonicalCutoverProfile"
        }
      ]
    },
    "modularMonolithAlphaProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maturity",
        "preset",
        "providers",
        "cadences",
        "gates",
        "command"
      ],
      "properties": {
        "id": {
          "const": "modular-monolith-alpha"
        },
        "maturity": {
          "const": "experimental"
        },
        "preset": {
          "const": "modular-monolith"
        },
        "providers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "postgresql",
              "sqlserver"
            ]
          }
        },
        "cadences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "release-candidate"
            ]
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^modular-monolith\\.[a-z0-9-]+$"
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "betaIntegrationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maturity",
        "preset",
        "providers",
        "cadences",
        "gates",
        "command"
      ],
      "properties": {
        "id": {
          "const": "beta-integration"
        },
        "maturity": {
          "const": "beta"
        },
        "preset": {
          "const": "platform"
        },
        "providers": {
          "type": "array",
          "maxItems": 0
        },
        "cadences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "release-candidate"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "beta.integration"
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "releaseCandidateProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maturity",
        "preset",
        "providers",
        "cadences",
        "gates",
        "command"
      ],
      "properties": {
        "id": {
          "const": "release-candidate"
        },
        "maturity": {
          "const": "release-candidate"
        },
        "preset": {
          "const": "platform"
        },
        "providers": {
          "type": "array",
          "maxItems": 0
        },
        "cadences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "release-candidate"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "release-candidate.evidence"
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stablePromotionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maturity",
        "preset",
        "providers",
        "cadences",
        "gates",
        "command"
      ],
      "properties": {
        "id": {
          "const": "stable-promotion"
        },
        "maturity": {
          "const": "stable"
        },
        "preset": {
          "const": "platform"
        },
        "providers": {
          "type": "array",
          "maxItems": 0
        },
        "cadences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "release-candidate"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "stable.promotion"
          }
        },
        "command": {
          "const": "npm run verify:stable-promotion"
        }
      }
    },
    "canonicalCutoverProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "maturity",
          "preset",
          "providers",
          "cadences",
          "gates",
          "command"
        ],
        "properties": {
          "id": {
            "const": "canonical-cutover"
          },
          "maturity": {
            "const": "stable"
          },
          "preset": {
            "const": "platform"
          },
          "providers": {
            "type": "array",
            "maxItems": 0
          },
          "cadences": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "release-candidate"
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "canonical.cutover"
            }
          },
          "command": {
            "const": "npm run verify:canonical-cutover"
          }
        }
    }
  }
}
