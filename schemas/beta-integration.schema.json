{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MartiXDev/Platform/schemas/beta-integration.schema.json",
  "title": "MartiX Platform beta integration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "solution",
    "targetPlatformVersion",
    "maturity",
    "matrix",
    "notAttested",
    "performance",
    "reviews",
    "changeFragments",
    "compatibility",
    "scopeFreeze",
    "supportClaims",
    "verification"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://github.com/MartiXDev/Platform/schemas/beta-integration.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "beta-integration-evidence"
    },
    "solution": {
      "const": "BetaIntegrationGeneratedSolution"
    },
    "targetPlatformVersion": {
      "const": "1.0.0-beta.1"
    },
    "maturity": {
      "const": "beta"
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "notAttested": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/notAttested"
      }
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "changeFragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/changeFragment"
      }
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "scopeFreeze": {
      "$ref": "#/$defs/scopeFreeze"
    },
    "supportClaims": {
      "type": "array",
      "maxItems": 0
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "id"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      }
    },
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "passed"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "providerCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "id",
        "preset",
        "status",
        "evidence"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "preset": {
          "enum": [
            "api",
            "modular-monolith",
            "full-stack"
          ]
        },
        "status": {
          "const": "passed"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "axes",
        "coverage",
        "coordinates",
        "invalidCombinations"
      ],
      "properties": {
        "strategy": {
          "const": "risk-based-covering-array"
        },
        "axes": {
          "$ref": "#/$defs/axes"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "invalidCombinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/invalidCombination"
          }
        }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presets",
        "endpointModels",
        "relationalProviders",
        "authenticationProfiles",
        "uiProviders",
        "infrastructureProviders",
        "deploymentProfiles"
      ],
      "properties": {
        "presets": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "api",
              "modular-monolith",
              "full-stack"
            ]
          }
        },
        "endpointModels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal-api",
              "fastendpoints"
            ]
          }
        },
        "relationalProviders": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "postgresql",
              "sqlserver"
            ]
          }
        },
        "authenticationProfiles": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "identity:interactive",
              "oidc:interactive",
              "oidc:api",
              "entra:interactive",
              "entra:api-delegated",
              "entra:api-application"
            ]
          }
        },
        "uiProviders": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "blazor-webapp",
              "react",
              "vue"
            ]
          }
        },
        "infrastructureProviders": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provider"
          }
        },
        "deploymentProfiles": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process",
              "oci",
              "direct",
              "aspire",
              "compose"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presets",
        "endpointModels",
        "relationalProviders",
        "authenticationProfiles",
        "uiProviders",
        "infrastructureProviders",
        "deploymentProfiles"
      ],
      "properties": {
        "presets": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "endpointModels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "relationalProviders": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "authenticationProfiles": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "uiProviders": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        },
        "infrastructureProviders": {
          "type": "array",
          "minItems": 10,
          "items": {
            "$ref": "#/$defs/providerCoverageEntry"
          }
        },
        "deploymentProfiles": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/coverageEntry"
          }
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "preset",
        "endpointModel",
        "relationalProvider",
        "authenticationProfile",
        "uiProvider",
        "infrastructureProviders",
        "deploymentProfiles",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "enum": [
            "api",
            "modular-monolith",
            "full-stack"
          ]
        },
        "endpointModel": {
          "enum": [
            "minimal-api",
            "fastendpoints"
          ]
        },
        "relationalProvider": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "postgresql",
                "sqlserver"
              ]
            }
          ]
        },
        "authenticationProfile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "none",
                "identity:interactive",
                "oidc:interactive",
                "oidc:api",
                "entra:interactive",
                "entra:api-delegated",
                "entra:api-application"
              ]
            }
          ]
        },
        "uiProvider": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "blazor-webapp",
                "react",
                "vue"
              ]
            }
          ]
        },
        "infrastructureProviders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider"
          }
        },
        "deploymentProfiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process",
              "oci",
              "direct",
              "aspire",
              "compose"
            ]
          }
        },
        "status": {
          "const": "passed"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invalidCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "combination",
        "outcome",
        "reason",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "combination": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "const": "invalid"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notAttested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "maturity",
        "reason",
        "reentryTrigger"
      ],
      "properties": {
        "id": {
          "enum": [
            "active24",
            "native-mobile"
          ]
        },
        "state": {
          "const": "not-attested"
        },
        "maturity": {
          "enum": [
            "planned",
            "parked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reentryTrigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "os",
        "runtime",
        "architecture"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "absolute",
            "relative"
          ]
        },
        "regressionPercent": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "signal",
        "unit",
        "value",
        "budget",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "baselineVersion",
        "runner",
        "noiseFloorRuns",
        "baselines"
      ],
      "properties": {
        "status": {
          "const": "recorded"
        },
        "baselineVersion": {
          "const": "1.0.0-beta.1"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "noiseFloorRuns": {
          "type": "integer",
          "minimum": 5
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/baseline"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "scope",
        "evidence"
      ],
      "properties": {
        "id": {
          "enum": [
            "threat-model",
            "supply-chain"
          ]
        },
        "status": {
          "const": "complete"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changeFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "impact",
        "migration",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/changes/.+\\.md$"
        },
        "impact": {
          "enum": [
            "patch",
            "minor",
            "major"
          ]
        },
        "migration": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "status": {
          "const": "reconciled"
        }
      }
    },
    "compatibilityInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "included"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "inputs"
      ],
      "properties": {
        "status": {
          "const": "recorded"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/compatibilityInput"
          }
        }
      }
    },
    "scopeFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "version",
        "allowedPostFreezeChanges",
        "prohibitedPostFreezeChanges",
        "decision"
      ],
      "properties": {
        "status": {
          "const": "frozen"
        },
        "version": {
          "const": "1.0"
        },
        "allowedPostFreezeChanges": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "defect",
              "evidence-gap",
              "release-blocker"
            ]
          }
        },
        "prohibitedPostFreezeChanges": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "feature",
              "provider"
            ]
          }
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "command",
        "failClosed",
        "requiredGates",
        "matrixDigest",
        "evidenceDigest"
      ],
      "properties": {
        "entrypoint": {
          "const": "eng/verify.mjs"
        },
        "command": {
          "const": "npm run verify:beta-integration"
        },
        "failClosed": {
          "const": true
        },
        "requiredGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "beta.integration"
          }
        },
        "matrixDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
