<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>MartiX.TemplateTestApp.Billing</RootNamespace>
    <AssemblyName>MartiX.TemplateTestApp.Billing</AssemblyName>
    <MartiXPlatformVersion>0.1.0-preview.1</MartiXPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MartiX.TemplateTestApp.Orders/MartiX.TemplateTestApp.Orders.csproj" />
    <PackageReference Include="MartiX.Platform" Version="$(MartiXPlatformVersion)" />
    <PackageReference Include="MartiX.Platform.AspNetCore" Version="$(MartiXPlatformVersion)" />
    <PackageReference Include="MartiX.Platform.Analyzers" Version="$(MartiXPlatformVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MartiX.TemplateTestApp.Tests" />
  </ItemGroup>
</Project>
