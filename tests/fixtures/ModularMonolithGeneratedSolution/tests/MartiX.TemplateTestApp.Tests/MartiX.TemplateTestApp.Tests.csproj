<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MartiXPlatformVersion>0.1.0-preview.1</MartiXPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MartiX.TemplateTestApp.Api/MartiX.TemplateTestApp.Api.csproj" />
    <ProjectReference Include="../../src/MartiX.TemplateTestApp.Client/MartiX.TemplateTestApp.Client.csproj" />
    <ProjectReference Include="../../src/MartiX.TemplateTestApp.Migrator/MartiX.TemplateTestApp.Migrator.csproj" />
    <ProjectReference Include="../../src/MartiX.TemplateTestApp.Orders/MartiX.TemplateTestApp.Orders.csproj" />
    <ProjectReference Include="../../src/MartiX.TemplateTestApp.Billing/MartiX.TemplateTestApp.Billing.csproj" />
    <PackageReference Include="MartiX.Platform" Version="$(MartiXPlatformVersion)" />
    <PackageReference Include="MartiX.Platform.AspNetCore" Version="$(MartiXPlatformVersion)" />
    <PackageReference Include="MartiX.Platform.Analyzers" Version="$(MartiXPlatformVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
    <PackageReference Include="TUnit" Version="1.63.0" />
  </ItemGroup>
</Project>
