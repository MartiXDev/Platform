{
  "$schema": "https://github.com/MartiXDev/Platform/schemas/martix.platform.schema.json",
  "kind": "generated-solution",
  "manifestSchemaVersion": "1.0.0",
  "platformVersion": "0.1.0-preview.1",
  "platformContractVersion": "0.1.0-preview.1",
  "repository": {
    "organization": "MartiXDev",
    "name": "MartiX.AlphaRehearsal",
    "product": "MartiX Alpha Rehearsal",
    "role": "generated-solution"
  },
  "origin": {
    "canonicalRepository": "https://github.com/MartiXDev/Platform",
    "template": "martix-app"
  },
  "preset": "modular-monolith",
  "capabilities": [
    {
      "id": "kernel.result-error",
