    "policy": "eng/quality-gates.json",
    "cadences": [
      "fast",
      "pull-request",
      "main-nightly",
      "release-candidate"
    ]
  },
  "modules": [
    {
      "name": "Orders",
      "project": "src/MartiX.AlphaRehearsal.Orders",
      "contractsNamespace": "MartiX.AlphaRehearsal.Orders.Contracts",
      "dependencies": []
    }
  ]
