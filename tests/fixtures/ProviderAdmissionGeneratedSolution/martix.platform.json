{
  "$schema": "../../../schemas/martix.platform.schema.json",
  "kind": "generated-solution",
  "manifestSchemaVersion": "1.0.0",
  "platformVersion": "0.1.0-preview.1",
  "platformContractVersion": "0.1.0-preview.1",
  "repository": {
    "organization": "MartiXDev",
