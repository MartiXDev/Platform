{
  "feature_management": {
    "feature_flags": [
      {
        "id": "CheckoutV2",
        "enabled": true
      },
      {
        "id": "DisabledCheckout",
        "enabled": false
      },
      {
        "id": "TargetedCheckout",
        "enabled": true,
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.Targeting",
              "parameters": {
                "Audience": {
                  "Users": [
                    "pilot-user"
                  ],
                  "Groups": [],
                  "DefaultRolloutPercentage": 0
                }
              }
            }
          ]
        }
      },
      {
        "id": "CheckoutVariant",
        "enabled": true,
        "allocation": {
          "default_when_enabled": "Control",
          "user": [
            {
              "variant": "Experiment",
              "users": [
                "pilot-user"
              ]
            }
          ]
        },
        "variants": [
          {
            "name": "Control",
            "status_override": "Enabled"
          },
          {
            "name": "Experiment",
            "status_override": "Enabled"
          }
        ]
      },
      {
        "id": "RefreshProbe",
        "enabled": true
      },
      {
        "id": "MissingFilter",
        "enabled": true,
        "conditions": {
          "client_filters": [
            {
              "name": "UnavailableFilter"
            }
          ]
        }
      },
      {
        "id": "MalformedFlag",
        "enabled": "not-a-boolean"
      },
      {
        "id": "TelemetryProbe",
        "enabled": true,
        "telemetry": {
          "enabled": true,
          "metadata": {
            "surface": "feature-management"
          }
        }
      }
    ]
  }
}
