{
  "name": "martix-fullstacktestapp-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
